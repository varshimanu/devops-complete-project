pipeline {
    agent any
 
    stages {
 
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
 
        stage('Build Docker Image') {
            steps {
                sh 'docker build -t php-app:latest .'
            }
        }
 
        stage('Deploy Container') {
            steps {
                sh '''
                docker stop php-app || true
                docker rm php-app || true
                docker run -d --name php-app -p 80:80 php-app:latest
                '''
            }
        }
 
    }
}
